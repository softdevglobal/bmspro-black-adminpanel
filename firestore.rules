rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function workshopOwnerUid() {
      let u = userDoc();
      return (u != null
              && 'ownerUid' in u
              && u.ownerUid is string
              && u.ownerUid.size() > 0)
        ? u.ownerUid
        : request.auth.uid;
    }

    // Firestore rules do not support Map.get(); use `in` + field access.
    function canReadNotification() {
      return signedIn() && (
        ('staffUid' in resource.data && resource.data.staffUid == request.auth.uid) ||
        ('ownerUid' in resource.data && resource.data.ownerUid == request.auth.uid) ||
        ('customerUid' in resource.data && resource.data.customerUid == request.auth.uid) ||
        ('branchAdminUid' in resource.data && resource.data.branchAdminUid == request.auth.uid) ||
        ('targetAdminUid' in resource.data && resource.data.targetAdminUid == request.auth.uid) ||
        ('targetOwnerUid' in resource.data && resource.data.targetOwnerUid == request.auth.uid) ||
        ('targetStaffUid' in resource.data && resource.data.targetStaffUid == request.auth.uid) ||
        ('ownerUid' in resource.data && resource.data.ownerUid == workshopOwnerUid()) ||
        ('targetOwnerUid' in resource.data && resource.data.targetOwnerUid == workshopOwnerUid()) ||
        ('targetAdminUid' in resource.data && resource.data.targetAdminUid == workshopOwnerUid())
      );
    }

    // ─── Collections ────────────────────────────────────────────────────

    match /super_admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if signedIn();
    }

    match /bookings/{bookingId} {
      allow read, write: if signedIn();
    }

    match /services/{serviceId} {
      allow read, write: if signedIn();
    }

    match /branches/{branchId} {
      allow read, write: if signedIn();
    }

    match /customers/{customerId} {
      allow read, write: if signedIn();
    }

    match /customer_deletions/{ownerUid} {
      allow read, write: if signedIn() && request.auth.uid == ownerUid;
    }

    match /subscription_plans/{planId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /auditLogs/{logId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    match /superAdminAuditLogs/{logId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    // Call center 1:1 chats — intended: participants read only; writes via Admin SDK.
    // SECURITY: If you keep `match /{document=**}` below with allow read/write for all
    // signed-in users, those lines ALSO match this path and access becomes OR’d — so any
    // signed-in client could still read/write here. Remove or tighten the catch-all for
    // real isolation; many teams rely on Admin SDK + app code only.
    match /cc_direct_chats/{chatId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/cc_direct_chats/$(chatId)).data.participantIds;
        allow write: if false;
      }
    }

    match /notifications/{notifId} {
      allow read: if canReadNotification();
      allow update: if canReadNotification()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}
