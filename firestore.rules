rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Super admins - can read own doc only
    match /super_admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // Users
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Bookings
    match /bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }

    // Services
    match /services/{serviceId} {
      allow read, write: if request.auth != null;
    }

    // Branches
    match /branches/{branchId} {
      allow read, write: if request.auth != null;
    }

    // Customers
    match /customers/{customerId} {
      allow read, write: if request.auth != null;
    }

    // Customer deletions (admin-panel: hide deleted customers from list)
    match /customer_deletions/{ownerUid} {
      allow read, write: if request.auth != null && request.auth.uid == ownerUid;
    }

    // Subscription plans (public read for signup)
    match /subscription_plans/{planId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // Super admin audit logs
    match /superAdminAuditLogs/{logId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Workshop owner id for this user (branch_admin/staff store ownerUid; owners use their auth uid).
    function effectiveWorkshopOwnerUid() {
      let u = currentUserDoc();
      return ('ownerUid' in u && u.ownerUid is string && u.ownerUid.size() > 0)
        ? u.ownerUid
        : request.auth.uid;
    }

    // Notifications - users can only read their own (fixes branch admin permission-denied)
    match /notifications/{notifId} {
      allow read: if request.auth != null && (
        resource.data.staffUid == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid ||
        resource.data.customerUid == request.auth.uid ||
        resource.data.branchAdminUid == request.auth.uid ||
        resource.data.targetAdminUid == request.auth.uid ||
        resource.data.targetOwnerUid == request.auth.uid ||
        ('role' in currentUserDoc() && currentUserDoc().role == 'branch_admin' &&
          resource.data.keys().hasAny(['targetOwnerUid']) &&
          resource.data.targetOwnerUid == effectiveWorkshopOwnerUid())
      );
      allow create, update, delete: if false; // Server (Admin SDK) writes only
    }

    // Catch-all for any other collections used by the app
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
